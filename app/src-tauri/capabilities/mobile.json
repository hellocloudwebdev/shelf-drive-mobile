{
  "identifier": "mobile-only",
  "description": "Permissions required only on Android. The webview never calls plugin-fs; the read grant is scoped to the same preview/thumbnail/offline folders the asset protocol already exposes so no session, database, or settings file is reachable.",
  "platforms": [
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "os:default",
    "store:default",
    "deep-link:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "fs:allow-read",
      "allow": [
        { "path": "$APPCACHE/previews/**" },
        { "path": "$APPDATA/thumbnails/**" },
        { "path": "$APPDATA/workspace/*/offline/**" }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "shell:allow-open"
  ]
}
